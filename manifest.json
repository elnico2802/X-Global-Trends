{
  "manifest_version": 3,
  "name": "X Global Trends",
  "version": "0.1.0",
  "description": "MVP de navegación de tendencias globales dentro de X.",
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["src/trends.js", "src/ui.js", "src/content.js"],
      "css": ["styles/trends.css"],
      "run_at": "document_idle"
    }
  ]
}
