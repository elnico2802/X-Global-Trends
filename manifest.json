{
  "manifest_version": 3,
  "name": "X Global Trends",
  "version": "0.9.0",
  "description": "Consulta tendencias globales y por país directamente desde X con una interfaz integrada y privada.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://trends24.in/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["src/trends.js", "src/providers/trends24.js", "src/ui.js", "src/content.js"],
      "css": ["styles/trends.css"],
      "run_at": "document_idle"
    }
  ]
}
